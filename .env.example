# SmartGrow AI Environment Configuration Example

# Backend Core
APP_NAME="SmartGrow AI"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-very-secure-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (SQLite default for dev; or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./smartgrow.db

# Device Security
DEVICE_REGISTRATION_TOKEN=smartgrow-device-enrollment-secret-2026
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
COMMAND_DEFAULT_TTL_SECONDS=300

# Firmware & OTA
FIRMWARE_STORAGE_PATH=./firmware_storage
MAX_FIRMWARE_SIZE_BYTES=16777216

# Initial Admin Credentials (seeded on first startup if no user exists)
INITIAL_ADMIN_EMAIL=admin@smartgrow.local
INITIAL_ADMIN_PASSWORD=Admin@SmartGrow2026!
INITIAL_ADMIN_FULL_NAME="Greenhouse System Administrator"
